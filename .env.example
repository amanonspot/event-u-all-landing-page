# Formspree endpoint for the proposal / contact lead form.
# Create a form at https://formspree.io and paste its endpoint URL here.
# Copy this file to .env.local and fill in the real value (never commit .env.local).
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Public site URL used for canonical metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://eventuall.com

# WhatsApp number in international format without + or spaces (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# ── Event films (hosted externally; posters ship in /public/videos/posters) ──
# Upload the compressed MP4s to your host (Cloudflare Stream/Bunny/S3/etc.) and
# paste the URLs here. Leave blank to show posters with a "coming soon" state.
# Hero plays a bundled local clip (/videos/hero-aerial.mp4) by default.
# Set this to a CDN URL only if you want to serve the hero video externally.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_WORK_VIDEO_FAFAI_AERIAL=
NEXT_PUBLIC_WORK_VIDEO_FAFAI_HIGHLIGHTS=
NEXT_PUBLIC_WORK_VIDEO_HALFTIME=
NEXT_PUBLIC_WORK_VIDEO_IEXCEED=
